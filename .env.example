# SIH26106 Threat Platform Environment Configuration

# Database
DATABASE_URL=sqlite:///./email_threat.db

# API & Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=10

# Geolocation Provider (ip-api or local)
GEO_PROVIDER=ip-api

# External Threat Intelligence Feeds (Optional - platform operates 100% offline if empty)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=

# NLP Model Configuration
NLP_ENGINE=rule_and_tfidf
